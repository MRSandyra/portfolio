# Copy to .env locally or provide these values through the web-server environment.
# Never commit a populated .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anomali_detection
DB_USER=change_me
DB_PASSWORD=change_me

# Public, HTTPS base URL without a trailing slash. Required to send reset links.
APP_BASE_URL=https://anomaly.example.com
RESET_EMAIL_FROM=no-reply@anomaly.example.com

# Use an absolute path in production when Python is not on PATH.
PYTHON_BIN=python3
ANALYSIS_TIMEOUT_SECONDS=30
# Absolute directory outside the web root, writable only by the web-server account.
ANALYSIS_WORKSPACE_ROOT=/var/lib/cybersecurity-anomaly-analysis
